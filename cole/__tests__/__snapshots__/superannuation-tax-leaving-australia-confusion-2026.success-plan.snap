        }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || "Assessment failed");
      setAssessment(data.assessment);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to generate assessment");
